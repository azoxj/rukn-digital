{
  "name": "azenk-platform",
  "version": "1.0.0",
  "private": true,
  "description": "AZENK server products (Call Center, Graduation, Requests) and AZENK Demo Center on a shared zero-dependency core: Node built-ins + SQLite.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "callcenter": "node --disable-warning=ExperimentalWarning apps/callcenter/server.js",
    "graduation": "node --disable-warning=ExperimentalWarning apps/graduation/server.js",
    "requests": "node --disable-warning=ExperimentalWarning apps/requests/server.js",
    "democenter": "node --disable-warning=ExperimentalWarning apps/democenter/server.js",
    "bootstrap": "node --disable-warning=ExperimentalWarning scripts/bootstrap.js",
    "seed:demo": "node --disable-warning=ExperimentalWarning scripts/seed-demo.js",
    "check": "node scripts/check.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"tests/*.test.js\"",
    "build:demo": "node scripts/build-demo.js"
  },
  "devDependencies": {
    "@noble/hashes": "1.6",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.2",
    "sql.js": "1.12"
  }
}
