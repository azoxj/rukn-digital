# Copy to your process manager / host environment. Never commit real values.
PORT=4100
HOST=127.0.0.1
# SQLite file and upload directory (default: platform/data/<app>.db)
DB_FILE=
DATA_DIR=
# Set to 1 when served over HTTPS (adds Secure cookies + HSTS)
COOKIE_SECURE=0
# Set to 1 only behind a trusted reverse proxy (uses X-Forwarded-For)
TRUST_PROXY=0
# Organisation time zone offset in minutes (Riyadh = 180)
TZ_OFFSET_MINUTES=180
# Rate limits
API_RATE_LIMIT=600
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_PER_IP=30
# Password hashing cost (2^N). 15 is the default; tests use a lower value.
SCRYPT_LOG_N=15
